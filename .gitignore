
# ==========================================
# CoffeeVision - Git Ignore Configuration
# ==========================================

# Virtual environments
.venv/
venv/
env/

# Python temporary files
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Sensitive configuration
.env
.env.*
!.env.example
*.key
*.pem
secrets.json
credentials.json

# Datasets and annotations
/data/*
!/data/.gitkeep
!/data/README.md

# Trained ML/DL models
/models/*
!/models/.gitkeep
!/models/README.md

# Model files
*.pt
*.pth
*.ckpt
*.h5
*.keras
*.onnx
*.tflite

# Video files
*.mp4
*.avi
*.mov
*.mkv
*.webm

# Local database
*.db
*.sqlite
*.sqlite3

# MLflow experiments
mlruns/
mlartifacts/

# Logs and temporary files
*.log
logs/
tmp/
temp/

# macOS
.DS_Store

# Jupyter checkpoints
.ipynb_checkpoints/
